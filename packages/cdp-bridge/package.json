{
  "name": "@remote-devtools/cdp-bridge",
  "private": false,
  "version": "0.3.5",
  "author": "ekworp",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "nodemon --delay 10 --watch src --watch ../remote-userscript/src --ext ts --exec \"pnpm build && node dist/index.js\"",
    "start": "node dist/index.js",
    "test": "pnpm build && node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "nodemon": "^3.1.10",
    "typescript": "^5.9.2"
  }
}
